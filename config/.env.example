# === LLM API Keys ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# === Ollama (offline mode) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === Semantic Scholar ===
SEMANTIC_SCHOLAR_API_KEY=your_s2_api_key_here  # optional: higher rate limits with key

# === PubMed (NCBI) ===
NCBI_EMAIL=your_email@example.com  # required by NCBI terms of service
NCBI_API_KEY=your_ncbi_api_key_here  # optional: 10 req/sec vs 3 req/sec

# === Privacy Mode ===
# Set to "true" to disable all cloud LLM APIs and use Ollama only
PRIVACY_MODE=false

# === Data Paths ===
DATA_DIR=./data
MODELS_DIR=./models

# === Knowledge Base ===
BRAIN_FILE=./SECOND-KNOWLEDGE-BRAIN.md

# === Agent Config ===
LOG_LEVEL=INFO
AGENT_PORT=8018

# === Agent Authentication ===
# Set a non-empty value to require X-API-Key header on all API endpoints
# Leave empty for local development (no auth required)
AGENT_API_KEY=

# === CORS ===
# Comma-separated allowed origins. Use * for all, or specify domains.
CORS_ORIGINS=*

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# === Logging ===
LOG_DIR=./data/logs
